# =========================================================
# kt66 실습 환경 설정 (단일 VM Docker)
# =========================================================
# 처음 한 번:
#   cp .env.example .env
# 외부 LLM 서버를 쓸 거면 LLM_BASE_URL 만 수정.

# ----- 시각(타임존) -----
# 전체 컨테이너 KST 통일. MISP/OpenCTI 등 ${TZ} 소비 스택의 기본값으로도 사용.
TZ=Asia/Seoul

# ----- 외부 LLM (선택, Bastion AI 기능용) -----
LLM_BASE_URL=
LLM_MODEL=gemma3:4b

# ----- AICompanion LLM 백엔드 (선택) -----
# 기본 mock(키워드 시뮬). 실제 모델은 보통 web /admin 에서 런타임 지정(볼륨에 영속)하므로
# 아래는 배포 초기 기본값일 뿐. 부팅부터 실제 모델로 시작하려면 ollama 로 설정.
AICOMPANION_LLM_BACKEND=mock

# ----- SSH 계정 (모든 컨테이너 공통) -----
SSH_USER=ccc
SSH_PASS=ccc

# ----- 외부 노출 포트 -----
PORT_HTTP=80              # http://VMIP/ 랜딩 + JuiceShop reverse proxy
PORT_HTTPS=443            # https://VMIP/
PORT_BASTION_SSH=2204     # ssh ccc@VMIP -p 2204 (점프 호스트)
PORT_ATTACKER_SSH=2202    # ssh ccc@VMIP -p 2202 (직접 attacker 진입)
PORT_PORTAL=8000          # http://VMIP:8000/ 관리 포털
PORT_SIEM_DASH=5601       # http://VMIP:5601/ SIEM lite UI
PORT_BASTION_API=9100     # http://VMIP:9100/health Bastion API

# ----- API 인증 -----
API_KEY=ccc-api-key-2026

# ----- 내부 GUI 바인딩 IP -----
# 관제(8020)·주입기(8030)·envsim(8010)·agentops(8050)·modelops(8060)·infraops(8070)
# ·SIEM(5601)·관리 포털(8000)·보안 콘솔(8081~8083) 이 전부 이 IP 에 publish 된다.
#
# 비워 두면 kt66.sh up 이 **웹 진입 IP(WEB_HOST_IP)** 를 적어 준다 — 학생이 이미
# 쓰는 주소라 배포하면 그냥 열린다. (직접 `docker compose up` 을 쓰면 0.0.0.0.)
#
# 예전 기본값은 192.168.136.145 였다. el34 에서 물려받은 dummy NIC 로, 그 서버의
# 브라우저에서만 열린다. 새 서버에 배포하면 취약 웹앱과 SIEM 은 열리는데 데이터센터
# 콘솔만 통째로 안 열리는 증상이 여기서 나왔다 — 컨테이너도 포트도 정상인데 아무도
# 닿을 수 없는 주소에 묶여 있었던 것이다.
#
# 강의실 LAN 에서 관제·SIEM 을 감추고 싶으면(호스트 브라우저 + SSH 터널 전용) 아래를 켠다:
#   INT_HOST_IP=192.168.136.145
#INT_HOST_IP=

# ----- 웹 진입 IP -----
# kt66.sh install 이 1회 질의해 기록한다. 직접 적어도 된다(이 값이 학생 hosts 의 대상 IP).
#WEB_HOST_IP=
