def default_envsim():
    # Compose may publish only on INT_HOST_IP; never source .env as shell code.
    host = os.getenv("INT_HOST_IP", "")
    if not host:
        envfile = ROOT.parent / ".env"
        if envfile.exists():
            for line in envfile.read_text().splitlines():
                key, sep, value = line.partition("=")
                if key.strip() == "INT_HOST_IP" and sep:
                    host = value.strip().strip("\"'")
                    break
    if not re.fullmatch(r"[A-Za-z0-9.-]+", host or "") or host == "0.0.0.0":
        host = "127.0.0.1"
    return f"http://{host}:8010"


