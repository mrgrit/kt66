    p = TICKETS / f"{stamp}.md"
    ids = sorted({a["id"] for a in alarms})
    p.write_text("\n".join([
        f"# 사건 {stamp} — {', '.join(ids)}",
        "",
        f"- 발생: {time.strftime('%Y-%m-%d %H:%M:%S')}",
        f"- 상태: open",
        "- 최초 경보:",
        *[f"  - [{a['level']}] {a['id']} {a['scope']} — {a['msg']}" for a in alarms],
        "",
    ]) + "\n", encoding="utf-8")
    return p


def append(path, title, w, model, body):
    p = pathlib.Path(path)
    session_line = ""
    audit_path = TICKETS / "runs.jsonl"
    if audit_path.is_file():
        try:
            latest = json.loads(audit_path.read_text().splitlines()[-1])
            if latest.get("worker") == w["id"] and latest.get("status") == "succeeded":
                session_line = "Session: " + str(latest.get("session_id", "unknown"))
        except (ValueError, IndexError):
            pass
    p.write_text(p.read_text(encoding="utf-8") + "\n".join([
        "",
        "---",
        "",
        f"## {title} — {agentctl.get(w,'name')} (`{w['id']}`)",
        f"*{time.strftime('%H:%M:%S')} · 자율성 {agentctl.get(w,'autonomy')} · "
        f"{agentctl.get(w,'model')} → --model {model or '세션 기본'}*",
        "",
        session_line,
        (body or "(응답 없음)").strip(),
        "",
    ]), encoding="utf-8")


def note(path, text):
    p = pathlib.Path(path)
    p.write_text(p.read_text(encoding="utf-8") + f"\n> {text}\n", encoding="utf-8")


def close(path, why):
    p = pathlib.Path(path)
    if not p.exists():
        return
    t = p.read_text(encoding="utf-8").replace("- 상태: open", "- 상태: closed", 1)
    p.write_text(t + f"\n---\n\n닫힘 {time.strftime('%Y-%m-%d %H:%M:%S')} — {why}\n",
                 encoding="utf-8")


# ── 경험그래프 ──────────────────────────────────────────────────────
# roster.yaml 은 team 을 두고 "KPI 귀속과 경험그래프가 여기서 온다"고 적어 뒀는데,
# 정작 그래프에는 **사람이 없었다**. 자산·증상·원인·조치만 있고 누가 그 일을 겪었는지가
# 없으면, 같은 증상이 다시 떴을 때 "이거 전에 누가 봤지"에 답할 수 없다. 배정을 좋게
# 만드는 것은 결국 그 기록이다.
#
# 그래프의 규율 두 가지를 그대로 지킨다:
#   ① 모든 edge 는 source 를 갖는다 — 여기서는 티켓 파일이 출처다. 티켓을 열면 그
#      사람이 실제로 무엇을 적었는지 볼 수 있다. 근거 없는 edge 는 추측이고, 추측을
#      저장하면 다음 판단이 오염된다.
#   ② 겪은 것만 적는다 — 경보 34종을 미리 심지 않는다. 실제로 뜬 증상만 node 가 된다.
#      그게 "경험"그래프인 이유다.
def _symptom_id(alarm_id):
    """경보 id → 증상 node id. 기존 규약을 따른다(UPS_ONBATT → s.ups_onbatt)."""
    return "s." + alarm_id.lower()


def _one_line(obj):
    """node·edge 를 한 줄로. 원본이 그 형식이다 — 표처럼 읽으라고 그렇게 쓴 파일이다."""
    return json.dumps(obj, ensure_ascii=False, separators=(", ", ": "))


def _insert_into_array(lines, key, new_lines):
    """`"key": [` 배열의 닫는 괄호 앞에 줄을 끼워 넣는다.

    json.dumps 로 통째로 다시 쓰면 안 된다. 이 파일은 사람이 손으로 묶어 둔 빈 줄로
    자산·증상·원인을 구분하고, node 하나를 한 줄에 적는다. 다시 직렬화하면 그 편집이
    전부 사라진다 — 실제로 한 번 그렇게 뭉갰다. 읽기는 json 으로 하고 쓰기는 줄 단위다.
    """
    head = next(i for i, l in enumerate(lines)
                if l.strip().startswith(f'"{key}"') and l.rstrip().endswith("["))
    indent = len(lines[head]) - len(lines[head].lstrip())
    end = next(i for i in range(head + 1, len(lines))
               if lines[i].strip() in ("],", "]")
               and len(lines[i]) - len(lines[i].lstrip()) == indent)
    prev = end - 1
    while prev > head and not lines[prev].strip():
        prev -= 1
    if not lines[prev].rstrip().endswith(","):        # 마지막 항목에 쉼표를 붙인다
        lines[prev] = lines[prev].rstrip() + ","
    lines[end:end] = new_lines
    return lines


def record_experience(inc, workers):
    """사건이 닫힐 때 '누가 무엇을 다뤘는가'를 남긴다. 같은 사실을 두 번 적지 않는다."""
    roles = inc.get("roles") or {}
    seen = inc.get("seen_alarms") or {}
    if not roles or not seen or not GRAPH.exists():
        return 0
    raw = GRAPH.read_text(encoding="utf-8")
    try:
        g = json.loads(raw)
    except ValueError as e:
        log(f"⚠ 경험그래프를 읽지 못했다: {e}")
        return 0

    have = {n["id"] for n in g.get("nodes", [])}
    edges = g.get("edges", [])
    src = pathlib.Path(inc["ticket"]).name
    new_nodes, new_edges = [], []

    for wid, info in sorted(roles.items()):
        w = worker(workers, wid)
        nid = f"w.{wid}"
        if nid not in have:
            have.add(nid)
            new_nodes.append(_one_line({
                "id": nid, "kind": "worker",
                "label": agentctl.get(w, "name", wid) if w else wid,
                "floor": agentctl.get(w, "floor") if w else "",
                "zone": agentctl.get(w, "zone") if w else "",
                "team": agentctl.get(w, "team") if w else "",
            }))
        for aid in info.get("alarms") or []:
            sid = _symptom_id(aid)
            if sid not in have:
                have.add(sid)
                new_nodes.append(_one_line({"id": sid, "kind": "symptom",
                                            "label": seen.get(aid, aid), "from_alarm": aid}))
            dup = any(e.get("from") == nid and e.get("to") == sid
                      and e.get("type") == "handled" and e.get("source") == src
                      for e in edges)
            if dup:
                continue
            e = {"from": nid, "to": sid, "type": "handled", "source": src,
                 "seeded_from": f"cc-runner {info.get('at','')} · {info.get('role','')}",
                 "role": info.get("role", ""), "confidence": 1.0}
            edges.append(e)
            new_edges.append(_one_line(e))

    if not new_nodes and not new_edges:
        return 0

    lines = raw.split("\n")
    if new_nodes:
        _insert_into_array(lines, "nodes", [f"    {x}," for x in new_nodes[:-1]]
                           + [f"    {new_nodes[-1]}"])
    if new_edges:
        _insert_into_array(lines, "edges", [f"    {x}," for x in new_edges[:-1]]
                           + [f"    {new_edges[-1]}"])
    stamp = time.strftime("%Y-%m-%d")
    for i, l in enumerate(lines):
        if l.strip().startswith('"updated"'):
            lines[i] = f'  "updated": "{stamp}",'
            break
    out = "\n".join(lines)
    try:
        json.loads(out)                   # 망가뜨렸으면 쓰지 않는다
    except ValueError as e:
        log(f"⚠ 경험그래프 갱신을 취소했다 — 결과가 유효한 JSON 이 아니다: {e}")
        return 0
    tmp = GRAPH.with_suffix(".json.tmp")
    tmp.write_text(out, encoding="utf-8")
    tmp.replace(GRAPH)        # 원자적 교체 — 콘솔이 같은 파일을 읽는 중일 수 있다
    return len(new_nodes) + len(new_edges)


# ── 한 바퀴 ─────────────────────────────────────────────────────────
def _sweep(dry=False):
    alarms = envsim("/alarms").get("active", [])
    injections = instructor_events.active(NOC_URL)
    alarms += instructor_events.to_alarms(injections)
    st = load_state()
    inc = st.get("incident")

    if not alarms:
        if inc:
            close(inc["ticket"], "경보가 모두 해제됐다")
            n = record_experience(inc, agentctl.load_roster())
            if n:
                note(inc["ticket"], f"경험그래프에 {n}건 기록 — graph/experience.json")
                log(f"경험그래프 갱신 {n}건 — 누가 무엇을 다뤘는가")
            log(f"사건 종료 — {pathlib.Path(inc['ticket']).name}")
            st.pop("incident")
            save_state(st)
        else:
            log("활성 경보 없음")
        return 0

    state = envsim("/state")
    records = instructor_events.siem_records(
        [i["handle"] for i in injections], [a["id"] for a in alarms if a.get("source") != "instructor"])
    if injections and not all(any(i["handle"] in e["full_log"] for e in records) for i in injections):
        log("instructor event detected; waiting for actual SIEM receipt evidence")
        return 0
    state["instructor_injections"] = [dict(id=i["id"], handle=i["handle"], target=i["target"], domain=i["domain"]) for i in injections]
    state["siem_evidence"] = records
    events = envsim("/events?limit=40").get("events", [])
    loops, workers = load_loops(), agentctl.load_roster()

    if inc is None:
        p = open_ticket(alarms)
        inc = {"ticket": str(p), "engaged": [], "verdicts": 0,
               "seen_alarms": {}, "roles": {}}
        st["incident"] = inc
        log(f"사건 접수 — 티켓 {p.name}")

    # 사건이 진행되며 경보는 늘거나 준다. 그래프에는 **겪은 것 전부**를 남겨야 하므로
    # 지금 떠 있는 것이 아니라 이제까지 본 것을 모은다(닫힐 때는 이미 다 걷혀 있다).
    inc.setdefault("seen_alarms", {}).update({a["id"]: a["msg"] for a in alarms})
    inc.setdefault("roles", {})

    def took(wid, role, alarm_ids):
        inc["roles"][wid] = {"role": role, "alarms": sorted(set(alarm_ids)),
                             "at": time.strftime("%Y-%m-%d %H:%M:%S")}

    inc.setdefault("attempts", {wid: 1 for wid in inc["engaged"]})
    inc.setdefault("last_attempt", {})

    def left():
        return MAX_SESSIONS - sum(inc["attempts"].values())

    def invoke(w, prompt, dry, label, schema=None):
        wid = w["id"]
        inc["attempts"][wid] = inc["attempts"].get(wid, 0) + 1
        inc["last_attempt"][wid] = time.time()
        save_state(st)  # reserve before launch, including crashes and failures
        alias, body = run_session(w, prompt, dry, label, schema=schema)
        if body is None:
            note(inc["ticket"], f"{wid}: session failed; no successful participation recorded.")
        return alias, body

    def read_ticket():
        return pathlib.Path(inc["ticket"]).read_text(encoding="utf-8")

    def runnable(w, role):
        """돌릴 몸이 있는가. 없으면 티켓에 남기고 예산은 쓰지 않는다."""
        if inc["attempts"].get(w["id"], 0) >= 2:
            return False
        if time.time() - inc["last_attempt"].get(w["id"], 0) < 5:
            return False
        if agentctl.get(w, "runtime") in ("claude", "codex"):
            return True
        msg = (f"{role} {w['id']} 는 런타임이 {agentctl.get(w,'runtime')} 라 세션을 띄우지 못했다"
               f" — `./agentctl runtime {w['id']} claude`")
        if w["id"] not in inc.setdefault("blocked_workers", []):
            log(f"⚠ {msg}")
            note(inc["ticket"], msg)
            inc["blocked_workers"].append(w["id"])
        return False

    matched, unmatched = fast_path(alarms, loops, workers)
    plan = {k: v for k, v in matched.items() if k not in inc["engaged"]}

    # ── ② 접수 → 라우팅 ───────────────────────────────────────────
    need_triage = bool(unmatched) or len(matched) >= 2
    if need_triage and DISPATCHER not in inc["engaged"] and left() > 0:
        d = worker(workers, DISPATCHER)
        if d is None:
            log(f"⚠ 접수자 {DISPATCHER} 가 명단에 없다 — 정적 매핑만으로 간다")
        elif runnable(d, "접수자"):
            log(f"접수 — 미배정 경보 {len(unmatched)}개 / 자동배정 {len(matched)}명")
            alias, body = invoke(
                d, triage_prompt(d, alarms, unmatched, matched, state, events, workers),
                dry, "접수")
            if body is None:
                save_state(st)
                return 0
            inc["engaged"].append(DISPATCHER)
            took(DISPATCHER, "접수", inc["seen_alarms"])   # 접수자는 사건 전체를 본다
            append(inc["ticket"], "접수", d, alias, body)
            route = parse_routing(body)
            for a in sorted(route.get("assign") or [],
                            key=lambda x: x.get("priority", 99)):
                wid = a.get("worker")
                w2 = worker(workers, wid)
                if not w2:
                    note(inc["ticket"], f"접수자가 명단에 없는 `{wid}` 를 배정했다 — 무시했다")
                    continue
                if wid in inc["engaged"] or wid in plan:
                    continue
                plan[wid] = {"w": w2, "loops": [], "alarms": unmatched,
                             "why": f"접수 배정 — {a.get('why','')}"}
            for u in route.get("unassigned") or []:
                note(inc["ticket"], f"미배정 {u.get('alarm')} — {u.get('why','')}")

    # ── 전문가 세션 ───────────────────────────────────────────────
    # 소견이 둘 이상 모이면 승인자를 불러야 한다. 그 몫 한 자리를 미리 떼어 둔다 —
    # 전문가로 예산을 다 쓰면 판정 없는 티켓이 남고, 그건 L2 절차가 아니다.
    approver = next((x for x in workers
                     if agentctl.get(x, "autonomy") == "approver"), None)
    needs_approval = inc.get("needs_approval", False) or any(
        agentctl.get(s["w"], "autonomy") == "L2" for s in plan.values())
    reserve = 1 if (approver and (needs_approval or inc["verdicts"] + len(plan) >= 2)) else 0

    for wid, s in sorted(plan.items(), key=lambda kv: kv[0]):
        if left() - reserve <= 0:
            note(inc["ticket"], f"세션 예산({MAX_SESSIONS}) 소진 — `{wid}` 미배정으로 남는다")
            log(f"⚠ 예산 소진 — {wid} 미배정")
            continue
        if not runnable(s["w"], "담당"):
            continue
        log(f"{wid} 호출 — {s['why']} / 경보 {', '.join(s['alarms']) or '—'}")
        alias, body = invoke(
            s["w"], worker_prompt(s["w"], s["loops"], s["alarms"], alarms, state, events,
                                  read_ticket()),
            dry, "소견")
        if body is None:
            break
        inc["engaged"].append(wid)
        inc["verdicts"] += 1
        if agentctl.get(s["w"], "autonomy") == "L2":
            inc["needs_approval"] = True
        took(wid, "소견", s["alarms"])
        append(inc["ticket"], "소견", s["w"], alias, body)

    # ── 승인 판정 ─────────────────────────────────────────────────
    if (approver and (inc["verdicts"] >= 2 or inc.get("needs_approval")) and approver["id"] not in inc["engaged"]
            and left() > 0 and runnable(approver, "승인자")):
        log(f"{approver['id']} 판정 — 소견 {inc['verdicts']}건")
        alias, body = invoke(
            approver, approval_prompt(approver, alarms, state, events, read_ticket()),
            dry, "판정")
        if body is not None:
            inc["engaged"].append(approver["id"])
            took(approver["id"], "판정", inc["seen_alarms"])
            append(inc["ticket"], "판정", approver, alias, body)

    if dry:
        st.pop("incident", None)                     # dry-run 은 상태를 남기지 않는다
    save_state(st)
    log(f"티켓 {pathlib.Path(inc['ticket']).name} — 세션 {len(inc['engaged'])}/{MAX_SESSIONS}")
    return len(inc["engaged"])


def _isolated_preview(callback):
    """Preview uses disposable copies and cannot close or erase a live incident."""
    global TICKETS, STATE, GRAPH
    old = TICKETS, STATE, GRAPH
    st = copy.deepcopy(load_state())
    with tempfile.TemporaryDirectory(prefix="kt66-preview-") as td:
        TICKETS = pathlib.Path(td)
        STATE = TICKETS / ".state.json"
        GRAPH = TICKETS / "experience.json"
        try:
            if old[2].exists():
                GRAPH.write_bytes(old[2].read_bytes())
            if st.get("incident"):
                source = pathlib.Path(st["incident"]["ticket"])
                target = TICKETS / source.name
                target.write_text(source.read_text() if source.exists() else "# Preview\n")
                st["incident"]["ticket"] = str(target)
            save_state(st)
            return callback()
        finally:
            TICKETS, STATE, GRAPH = old


def sweep(dry=False):
    if dry:
        return _isolated_preview(lambda: _sweep(True))
    TICKETS.mkdir(parents=True, exist_ok=True)
    with (TICKETS / ".runner.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            log("another runner is active; skipped")
            return 0
        return _sweep(False)


def cron_matches(expression, now):
    """Standard five-field cron, with cron's DOM/DOW OR semantics."""
    bounds = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]
    fields = expression.split()
    if len(fields) != 5:
        raise ValueError("cadence must have five fields")
    values = [now.minute, now.hour, now.day, now.month, (now.weekday() + 1) % 7]
    matched = []
    for i, (field, (lo, hi), value) in enumerate(zip(fields, bounds, values)):
        selected = set()
        for item in field.split(","):
            base, slash, step_text = item.partition("/")
            step = int(step_text) if slash else 1
            if step <= 0:
                raise ValueError("invalid cron step")
            if base == "*":
                start, end = lo, hi
            elif "-" in base:
                start, end = map(int, base.split("-"))
            else:
                start = int(base)
                end = hi if slash else start
            if not lo <= start <= end <= hi:
                raise ValueError("cron value out of range")
            selected.update(range(start, end + 1, step))
        if i == 4 and 7 in selected:
            selected.add(0)
        matched.append(value in selected)
    day = (matched[2] or matched[4]) if fields[2] != "*" and fields[4] != "*" else (matched[2] and matched[4])
    return matched[0] and matched[1] and matched[3] and day


def scheduled_sweep(dry=False, now=None):
    """Opt-in periodic analysis. No actuator is attached to this scheduler."""
    from zoneinfo import ZoneInfo
    now = now or datetime.datetime.now(ZoneInfo(os.getenv("KT66_RUNNER_TZ", "Asia/Seoul")))
    if dry:
        return _isolated_preview(lambda: _scheduled_sweep(True, now))
    TICKETS.mkdir(parents=True, exist_ok=True)
    with (TICKETS / ".runner.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        return _scheduled_sweep(False, now)


def _scheduled_sweep(dry, now):
    st = load_state()
    slots = st.setdefault("scheduled", {})
    workers, loops = agentctl.load_roster(), load_loops()
    slot = now.isoformat(timespec="minutes")
    due = []
    for lid, lp in loops.items():
        try:
            matches = cron_matches(lp.get("cadence", ""), now)
        except (ValueError, TypeError):
            log(f"{lid}: invalid cadence")
            continue
        if matches and slots.get(lid, {}).get("slot") != slot:
            due.append((lid, lp))
    if not due:
        return 0
    state = envsim("/state")
    alarms = envsim("/alarms").get("active", [])
    events = envsim("/events?limit=40").get("events", [])
    calls = 0
    day = now.date().isoformat()
    daily = st.setdefault("scheduled_daily", {"date": day, "calls": 0})
    if daily.get("date") != day:
        daily.update(date=day, calls=0)
    daily_limit = int(os.getenv("KT66_SCHEDULED_DAILY_LIMIT", "20"))
    for lid, lp in due:
        w = worker(workers, lp.get("owner"))
        rec = {"slot": slot, "worker": lp.get("owner"), "status": "blocked",
               "mode": "analysis_only"}
        slots[lid] = rec
        if not w or lid not in (w.get("loops") or []):
            rec["reason"] = "owner_not_bound_in_roster"
            save_state(st)
            continue
        if agentctl.get(w, "runtime") not in ("claude", "codex"):
            rec["reason"] = "runtime_not_supported"
            save_state(st)
            continue
        if calls >= MAX_SESSIONS:
            rec["reason"] = "per_sweep_budget_exhausted"
            save_state(st)
            continue
        if daily["calls"] >= daily_limit:
            rec["reason"] = "daily_budget_exhausted"
            save_state(st)
            continue
        daily["calls"] += 1
        rec["status"] = "running"
        save_state(st)  # reserve slot before model invocation; never replay on restart
        prompt = worker_prompt(w, [lp], [], alarms, state, events, "")
        prompt += ("\n\nPeriodic review: " + lid + " at " + slot +
                   "\nOnly supplied envsim data is available. Explicitly report missing "
                   "logs, metrics or backup evidence. Do not claim checks ran or passed "
                   "without evidence. Produce findings and proposed actions only; "
                   "no action executor is attached.")
        alias, body = run_session(w, prompt, dry, "periodic:" + lid)
        calls += 1
        rec["status"] = "succeeded" if body else "failed"
        if body:
            path = open_ticket([])
            append(path, "Periodic review: " + lid, w, alias, body)
            note(path, "Analysis completed. Proposed changes are NOT executed or verified.")
            # This is a completed review, not a resolved operational incident.
            close(path, "Periodic analysis completed; no operational action performed")
            rec["ticket"] = str(path)
        save_state(st)
    return calls


def show_status():
    st = load_state()
    workers = agentctl.load_roster()
    result = {"envsim_url": ENVSIM, "mode": "analysis_only",
              "execution": "fresh_cli_session", "api_fallback": False,
              "automatic_actions": False, "workers": [],
              "scheduled": st.get("scheduled", {}),
              "incident": st.get("incident")}
    for w in workers:
        rt = agentctl.get(w, "runtime")
        result["workers"].append({"id": w["id"], "runtime": rt,
            "model": agentctl.get(w, "model"), "loops": w.get("loops", []),
            "runner_supported": rt in ("claude", "codex"),
            "cli_installed": bool(ccs.shutil.which(rt)) if rt in ("claude", "codex") else None})
    try:
        result["active_alarms"] = len(envsim("/alarms").get("active", []))
        result["envsim_reachable"] = True
    except SystemExit:
        result["envsim_reachable"] = False
    result["authentication"] = {}
    for rt in ("claude", "codex"):
        try:
            result["authentication"][rt] = session_cli.authenticated(
                rt, session_cli.executable(rt), session_cli.clean_env())
        except (session_cli.SessionError, OSError, subprocess.TimeoutExpired) as e:
            result["authentication"][rt] = {"verified": False, "error": type(e).__name__}
    status = TICKETS / "runner-status.json"
    result["watcher"] = json.loads(status.read_text()) if status.exists() else None
    if result["watcher"]:
        result["watcher"]["heartbeat_recent"] = (
            result["watcher"].get("status") == "watching" and
            time.time() - result["watcher"]["at"] < max(60, POLL_SEC * 3))
    print(json.dumps(result, ensure_ascii=False, indent=2))


def heartbeat(scheduled, status="watching"):
    TICKETS.mkdir(parents=True, exist_ok=True)
    p = TICKETS / "runner-status.json"
    tmp = p.with_suffix(".tmp")
    tmp.write_text(json.dumps({"pid": os.getpid(), "at": time.time(),
                              "status": status, "scheduled_enabled": scheduled,
                              "mode": "analysis_only"}))
    tmp.replace(p)


def show_tickets():
    rows = sorted(TICKETS.glob("*.md"), reverse=True) if TICKETS.is_dir() else []
    if not rows:
        print("아직 티켓이 없다.")
        return
    for p in rows:
        lines = p.read_text(encoding="utf-8").splitlines()
        title = lines[0].lstrip("# ") if lines else p.stem
        stat = next((l.split(":", 1)[1].strip() for l in lines if l.startswith("- 상태:")), "?")
        who = [l.split("(`")[1].split("`)")[0] for l in lines if l.startswith("## ") and "(`" in l]
        print(f"  [{stat:<6}] {p.name}  {title}")
        print(f"           참여: {', '.join(who) or '—'}")


def main():
    ap = argparse.ArgumentParser(
        description="사건이 나면 담당 근무자의 구독 CC 세션을 돌린다")
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--watch", action="store_true", help=f"주기 폴링 ({POLL_SEC}초)")
    g.add_argument("--tickets", action="store_true", help="티켓 목록")
    ap.add_argument("--dry-run", action="store_true",
                    help="프롬프트만 찍는다. 세션도 안 띄우고 상태도 안 남긴다")
    g.add_argument("--status", action="store_true", help="Read-only runtime and execution status")
    ap.add_argument("--scheduled", action="store_true", help="Enable periodic analysis (consumes model usage)")
    a = ap.parse_args()
    if a.watch and not a.dry_run:
        import loop_engine
        return loop_engine.run()
    if a.status:
        status = ROOT / "tickets" / "loop-engine-status.json"
        print(status.read_text() if status.exists() else '{"status":"not_started"}')
        return 0

    if a.tickets:
        show_tickets()
        return 0
    if a.watch:
        log(f"{ENVSIM} 을 {POLL_SEC}초마다 본다. Ctrl-C 로 멈춘다.")
        try:
            while True:
                if not a.dry_run:
                    heartbeat(a.scheduled)
                try:
                    sweep(a.dry_run)
                    if a.scheduled:
                        scheduled_sweep(a.dry_run)
                except (SystemExit, OSError, ValueError) as e:
                    log(f"poll failed: {type(e).__name__}; retry on next poll")
                time.sleep(POLL_SEC)
        except KeyboardInterrupt:
            print()
            log("멈춘다")
        finally:
            if not a.dry_run:
                heartbeat(a.scheduled, "stopped")
        return 0
    if not a.dry_run:
        import loop_engine
        return loop_engine.run_once()
    sweep(a.dry_run)
    if a.scheduled:
        scheduled_sweep(a.dry_run)
    return 0


if __name__ == "__main__":
    sys.exit(main())
