# ── 세션 ────────────────────────────────────────────────────────────
def run_session(w, prompt, dry, label, schema=None):
    rt = agentctl.get(w, "runtime")
    entry = agentctl.load_models().get(agentctl.get(w, "model"), {})
    alias = entry.get("name")
    expected = {"claude": "claude-code", "codex": "codex-cli"}
    if dry:
        print(f"DRY RUN: fresh {rt} session / {label} / {w['id']} / model={alias}")
        print(prompt)
        return alias, "(dry-run; no session created)"
    started = time.time()
    result = {"worker": w["id"], "role": label, "runtime": rt, "model": alias,
              "started_at": started, "status": "failed", "mode": "analysis_only",
              "execution": "fresh_cli_session"}
    body = None
    try:
        if rt not in expected or entry.get("endpoint") != expected[rt] or not alias:
            raise session_cli.SessionError("unsupported_session_runtime_or_model")
        import harness_compiler
        dest, manifest = harness_compiler.compile_worker(w["id"], ROOT)
        evidence = ROOT / "evidence" / ("session-" + str(time.time_ns()) + "-" + w["id"])
        data = session_cli.run(rt, alias, prompt, timeout=min(180, SESSION_TIMEOUT),
                               schema=schema, harness=dest, evidence_dir=evidence)
        result.update(harness_version=manifest["version"], evidence_dir=str(evidence), mode="policy_tools")
        body = data["body"]
        result.update(status="succeeded", session_id=data["session_id"],
                      fresh_session=data["fresh_session"], auth=data["auth"],
                      usage=data.get("usage", {}), model_usage=data.get("model_usage", {}))
    except (OSError, ValueError, subprocess.TimeoutExpired, session_cli.SessionError) as e:
        result["error"] = str(e) if isinstance(e, session_cli.SessionError) else type(e).__name__
        log(f"{w['id']} / {label}: {result['error']}")
    result["duration_sec"] = round(time.time() - started, 3)
    TICKETS.mkdir(parents=True, exist_ok=True)
    with (TICKETS / "runs.jsonl").open("a", encoding="utf-8") as f:
        f.write(json.dumps(result, ensure_ascii=False) + "\n")
    return alias, body


def parse_routing(text):
    """접수 소견 끝의 json 코드블록을 뽑는다. 없거나 깨졌으면 빈 배정."""
    blocks = re.findall(r"```json\s*(.*?)```", text or "", re.S)
    for b in reversed(blocks):                       # 마지막 블록이 배정표다
        try:
            d = json.loads(b)
        except ValueError:
            continue
        if isinstance(d, dict) and "assign" in d:
            return d
    return {"assign": [], "unassigned": []}


# ── 티켓 ────────────────────────────────────────────────────────────
def load_state():
    if STATE.exists():
        try:
            return json.loads(STATE.read_text(encoding="utf-8"))
        except ValueError:
            pass
    return {}


def save_state(st):
    TICKETS.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, ensure_ascii=False, indent=1), encoding="utf-8")
    tmp.replace(STATE)


def open_ticket(alarms):
