# ── 랩 상태 ─────────────────────────────────────────────────────────
def envsim(path):
    try:
        with urllib.request.urlopen(f"{ENVSIM}{path}", timeout=5) as r:
            return json.load(r)
    except (urllib.error.URLError, OSError, ValueError) as e:
        sys.exit(f"[cc-runner] envsim({ENVSIM}) 에 닿지 못했다: {e}\n"
                 f"            ENVSIM_URL 로 주소를 지정할 수 있다.")


def load_loops():
    out = {}
    for p in sorted((ROOT / "loops").glob("*.yaml")):
        try:
            d = yaml.safe_load(p.read_text(encoding="utf-8")) or {}
        except yaml.YAMLError as e:
            log(f"⚠ {p.name} 를 읽지 못했다: {e}")
            continue
        out[d.get("id", p.stem)] = d
    return out


def worker(workers, wid):
    return next((x for x in workers if x["id"] == wid), None)


# ── ① 정적 매핑 ─────────────────────────────────────────────────────
def fast_path(alarms, loops, workers):
    """경보 → 루프 triggers → owner. 반환 {wid: {"w","loops","alarms"}} 와 미매칭 경보."""
    active = {a["id"] for a in alarms}
    covered, by_worker = set(), {}
    for lp in loops.values():
        hit = sorted(active & set((lp.get("triggers") or {}).get("alarms") or []))
        if not hit:
            continue
        covered.update(hit)
        w = worker(workers, lp.get("owner"))
        if not w:
            log(f"⚠ 루프 {lp.get('id')} 의 담당 {lp.get('owner')} 가 명단에 없다 — 건너뛴다")
            continue
        slot = by_worker.setdefault(w["id"], {"w": w, "loops": [], "alarms": set(), "why": "정적 트리거"})
        slot["loops"].append(lp)
        slot["alarms"].update(hit)
    for s in by_worker.values():
        s["alarms"] = sorted(s["alarms"])
    return by_worker, sorted(active - covered)


# ── 프롬프트 ────────────────────────────────────────────────────────
def persona_of(wid):
    p = ROOT / "personas" / f"{wid}.md"
    return p.read_text(encoding="utf-8").strip() if p.exists() else "(페르소나 파일이 없다)"


def snapshot(state):
    """판단에 쓰는 수치만. 컨테이너 목록 같은 건 뺀다."""
    keep = ("power", "plant", "weather", "fuel", "battery", "efficiency", "shed_analysis")
    return {k: state[k] for k in keep if k in state}


def alarm_lines(alarms, ids=None):
    out = []
    for a in alarms:
        if ids is not None and a["id"] not in ids:
            continue
        out.append(f"- [{a['level']}] {a['id']} {a['scope']} — {a['msg']} "
                   f"({a.get('metric')}={a.get('value')})")
    return out or ["- (없음)"]


def context_block(alarms, state, events):
    return [
        "## 지금 떠 있는 경보",
        *alarm_lines(alarms),
        "",
        "## 계통 실측값 (envsim)",
        "```json",
        json.dumps(snapshot(state), ensure_ascii=False, indent=1),
        "```",
        "",
        "## 최근 이벤트",
        # 별표 뒤에 or 를 그냥 쓰면 문법 오류다 — 괄호로 묶어야 리스트가 먼저 정해진다.
        *([f"- {e.get('kind')}: {e.get('msg')}" for e in events[-12:]] or ["- (없음)"]),
    ]


