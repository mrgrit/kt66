# kt66 호스트 네트워크 글루 — docker 기동 후 자동 재적용 (부팅/재시작 후 체인 보존).
# 설치는 kt66.sh 의 install_systemd 가 한다(경로를 실제 저장소 위치로 치환).
# 수동:  sudo cp kt66-net.service /etc/systemd/system/ && sudo systemctl enable --now kt66-net
# (컨테이너를 '운영 중' 재생성한 경우엔: sudo systemctl restart kt66-net  또는  ./kt66-net.sh)
[Unit]
Description=kt66 host network glue (bridge-nf-call=0 + DOCKER-USER inter-bridge ACCEPT)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# 컨테이너/브리지가 올라온 뒤 적용되도록 약간 대기
ExecStartPre=/bin/sleep 8
ExecStart=__KT66_DIR__/kt66-net.sh

[Install]
WantedBy=multi-user.target
